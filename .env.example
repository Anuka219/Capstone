# Copy this file to .env and fill in real values.

# LLM provider. Use Groq if you have a key, otherwise OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# ElevenLabs voice output.
# Put the professor cloned voice ID here after creating the voice in ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

PORT=8000
